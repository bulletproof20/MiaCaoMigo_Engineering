# Copy this file to .env.production and replace all placeholder values.
# Do not commit .env.production.

# Host ports exposed by Docker.
WEB_PORT=3000
DOCS_PORT=8000

# PostgreSQL bootstrap and runtime credentials.
POSTGRES_USER=miacaomigo_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=miacaomigo

# Backend security.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=6h

# Public URLs used by Swagger/CORS.
PUBLIC_API_BASE_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com
